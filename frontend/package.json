{
  "name": "frontend-assessment",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:coverage:watch": "jest --coverage --watch",
    "test:coverage:ci": "jest --coverage --ci",
    "test:coverage:ci:report": "jest --coverage --ci --reporters=default --reporters=jest-junit",
    "test:coverage:ci:report:watch": "jest --coverage --ci --reporters=default --reporters=jest-junit --watch",
    "test:coverage:ci:report:watch:all": "jest --coverage --ci --reporters=default --reporters=jest-junit --watchAll",
    "test:coverage:ci:report:watch:all:ci": "jest --coverage --ci --reporters=default --reporters=jest-junit --watchAll --ci",
    "test:coverage:ci:report:watch:all:ci:report": "jest --coverage --ci --reporters=default --reporters=jest-junit --watchAll --ci --reporters=default --reporters=jest-junit",
    "test:coverage:ci:report:watch:all:ci:report:all": "jest --coverage --ci --reporters=default --reporters=jest-junit --watchAll --ci --reporters=default --reporters=jest-junit --reporters=default --reporters=jest-junit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.5",
    "apexcharts": "^4.7.0",
    "next": "^14.1.0",
    "react": "^18.2.0",
    "react-apexcharts": "^1.7.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.27.1",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@tailwindcss/postcss": "^4.1.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.61",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "autoprefixer": "^10.4.21",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.5",
    "ts-jest": "^29.3.2",
    "typescript": "^5.3.3"
  }
}
